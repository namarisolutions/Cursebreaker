# On Railway, reference the plugin variables instead of pasting values:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_URL=postgres://postgres:pg@localhost:5432/board
# Optional locally; without it rate limits are per-process in memory.
REDIS_URL=

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Your Anthropic API key. Required for the AI to reply.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high (higher = more thorough, slower, more expensive)
CHAT_EFFORT=low

# First deploy only: creates your owner login if no admin exists yet. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: auto-delete conversations idle this many days (run scripts/retention.mjs on a schedule).
# RETENTION_DAYS=180

# Shown in the chat header, greeting, and dashboard.
APP_NAME=Cursebreaker

# Limits
CHAT_PER_MINUTE=8
CHAT_PER_DAY=300
CHAT_MESSAGES_PER_HOUR=2000
MAX_MESSAGE_LENGTH=4000
MAX_CONVERSATION_MESSAGES=200
# Comma-separated case-insensitive regexes; visitor messages matching any flag the conversation.
# FLAG_PATTERNS=
